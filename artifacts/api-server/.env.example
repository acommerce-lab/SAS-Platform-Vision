# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sas_platform

# ─── JWT / Session ───────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_to_another_strong_random_secret
JWT_REFRESH_EXPIRY=7d

# ─── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# ─── Maps / OSRM ─────────────────────────────────────────────────────────────
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_MS=5000
USER_AGENT=SASPlatform/1.0

# ─── Email / SMTP ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="SAS Platform <notifications@example.com>"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
